{
  "name": "electrical-construction-study",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate-bank.mjs",
    "test": "node tests/core.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:practical": "node tests/practical.mjs",
    "test:2021": "node tests/2021.mjs",
    "test:unseen": "node tests/unseen-checkbox.mjs",
    "test:round1": "node tests/round1.mjs",
    "test:rules": "firebase emulators:exec --project demo-electrical-study --only firestore 'node --test tests/rules.test.mjs'",
    "serve": "python3 -m http.server 4173 --directory public --bind 0.0.0.0",
    "test:update": "node tests/update.mjs",
    "test:sync": "firebase emulators:exec --project demo-electrical-study --only auth,firestore \"node tests/sync.mjs\"",
    "build:emulator-test": "node scripts/build-emulator-test.mjs",
    "test:persistence": "node tests/persistence.mjs",
    "test:update-cache": "node tests/update-cache.mjs",
    "test:insulation": "node tests/insulation.mjs",
    "test:photos": "node tests/photo-questions.mjs",
    "test:cap-luminaires": "node tests/capacitor-luminaires.mjs",
    "test:result-unseen": "node tests/result-unseen.mjs",
    "test:insulator-reference": "node tests/insulator-reference.mjs",
    "test:book4": "node --test tests/book4-content.test.mjs && node tests/book4.mjs",
    "test:rounds": "node --test tests/study-rounds.test.mjs && node tests/study-rounds.mjs"
  },
  "dependencies": {
    "firebase": "12.4.0"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "@playwright/test": "1.56.1",
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase-tools": "14.22.0"
  }
}
